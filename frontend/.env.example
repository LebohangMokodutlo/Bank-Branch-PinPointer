# Base URL of the Bank Branch PinPointer API. Vite only exposes env vars prefixed with VITE_ to
# browser code, read via `import.meta.env.VITE_API_BASE_URL` in whatever fetch/data-fetching
# code you write.
#
# Copy this file to `.env` (for `npm run dev`) and adjust if your API runs elsewhere.
VITE_API_BASE_URL=http://localhost:8080
